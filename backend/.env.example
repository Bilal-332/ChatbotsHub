# Application
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=https://chatbotshub.me

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/chatbotshub?retryWrites=true&w=majority

# Google OAuth
# Must be the SAME Web Client ID as NEXT_PUBLIC_GOOGLE_CLIENT_ID on the frontend.
# In Google Cloud Console → Credentials → OAuth 2.0 Web client:
#   Authorized JavaScript origins: https://chatbotshub.me, https://www.chatbotshub.me, http://localhost:3000
#   Authorized redirect URIs: not required for Google Identity Services (popup) button
GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
# Optional: comma-separated extra web client IDs (e.g. staging + production)
GOOGLE_ADDITIONAL_CLIENT_IDS=

# JWT
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIn0.NFznhW42RVVXs30dsu2tZ-jDWHuKuRiifJ6nw0NRQnA

# Groq AI (free tier)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192

# HuggingFace (for embeddings)
HUGGINGFACE_API_KEY=your_hf_api_key_here
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# File upload
MAX_FILE_SIZE_MB=10
UPLOAD_TEMP_DIR=./tmp/uploads

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CHAT_RATE_LIMIT_MAX=30

# Resend (password reset & contact emails)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=ChatbotsHub <noreply@yourdomain.com>
CONTACT_EMAIL=bilalkhan.fullstack@gmail.com
CONTACT_WHATSAPP=+923329368599

# SMTP (password reset emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=bilalkhan33293@gmail.com
SMTP_SECURE=false
SMTP_TIMEOUT_MS=10000
